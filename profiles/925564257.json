    "gleif: not_found (no LEI record lists this organisation number)",
    "wikidata: not_found (no Wikidata item has P2333 = this org number)",
    "nav_jobs: error (HTTP 429)",
    "geonorge: registered business address looked up in Kartverket's address register (postal code must match)",
    "website: not_found (guessed domain bccmediasti.no does not respond)"
   ]
  }
 }
}